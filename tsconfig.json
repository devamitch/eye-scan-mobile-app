{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Language and Environment
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    
    // Modules
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    
    // Emit
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "isolatedModules": true,
    
    // Type Checking - Strict Mode
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    
    // Additional Checks
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    
    // Interop Constraints
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "skipLibCheck": true,
    
    // Path Mapping
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@/assets/*": ["assets/*"],
      "@/ui/*": ["ui/*"],
      "@/components/*": ["components/*"],
      "@/features/*": ["features/*"],
      "@/navigation/*": ["navigation/*"],
      "@/store/*": ["store/*"],
      "@/services/*": ["services/*"],
      "@/database/*": ["database/*"],
      "@/themes/*": ["themes/*"],
      "@/hooks/*": ["hooks/*"],
      "@/utils/*": ["utils/*"],
      "@/config/*": ["config/*"],
      "@/types/*": ["types/*"],
      "@/constants/*": ["constants/*"],
      "@/lib/*": ["lib/*"],
      "@env": ["env.d.ts"]
    },
    
    // Type Roots
    "typeRoots": [
      "./node_modules/@types",
      "./src/types",
      "./src/@types"
    ],
    
    // Advanced Options
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src/**/*",
    "index.ts",
    "index.js",
    "App.tsx",
    "App.ts",
    "__tests__/**/*",
    "e2e/**/*",
    ".storybook/**/*",
    "env.d.ts",
    "svg.d.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "dist",
    ".expo",
    "coverage",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}