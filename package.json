{
  "name": "eye-scan-mobile-app",
  "version": "1.0.0",
  "description": "AI-Powered Eye Health Monitor - Your companion for eye comfort monitoring and wellness",
  "main": "index.ts",
  "author": {
    "name": "Amit Chakraborty",
    "email": "amit98ch@gmail.com",
    "url": "https://github.com/devamitch"
  },
  "license": "MIT",
  "keywords": [
    "eye-health",
    "eye-tracking",
    "health-monitoring",
    "computer-vision",
    "ai",
    "react-native",
    "expo"
  ],
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:dev": "expo start --dev-client",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "android-expo": "expo start --android",
    "android:release": "expo run:android --variant release",
    "android:clean": "cd android && ./gradlew clean && cd ..",
    "ios": "expo run:ios",
    "ios-expo": "expo start --ios",
    "ios:release": "expo run:ios --configuration Release",
    "ios:device": "expo run:ios --device",
    "ios:clean": "cd ios && xcodebuild clean && cd ..",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:clear": "jest --clearCache",
    "build:dev": "eas build --profile development --platform all",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform all",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform all",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:all": "eas submit --platform all",
    "update": "eas update",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production",
    "doctor": "expo doctor",
    "install:check": "expo install --check",
    "install:fix": "expo install --fix",
    "clean": "rm -rf node_modules && rm -rf .expo && rm -rf ios/Pods && yarn install",
    "clean:all": "rm -rf node_modules && rm -rf .expo && rm -rf ios && rm -rf android && yarn install",
    "reset": "yarn clean:all && yarn prebuild",
    "postinstall": "patch-package || true",
    "pods": "cd ios && pod install && cd ..",
    "pods:clean": "cd ios && rm -rf Pods && pod install && cd ..",
    "pods:update": "cd ios && pod update && cd ..",
    "analyze:bundle": "npx react-native-bundle-visualizer",
    "analyze:size": "du -sh node_modules/* | sort -hr | head -20",
    "build:aab": "cd android && ./gradlew bundleRelease && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.1.21",
    "@react-navigation/native-stack": "^7.8.0",
    "@tanstack/query-async-storage-persister": "^5.90.13",
    "@tanstack/react-query": "^5.90.11",
    "@tanstack/react-query-persist-client": "^5.90.13",
    "expo": "~54.0.29",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.12",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.10",
    "expo-notifications": "~0.32.15",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "lucide-react-native": "^0.555.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^3.3.0",
    "react-native-reanimated": "^4.1.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "patch-package": "^8.0.0",
    "prettier": "^3.0.0",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "yarn": ">=4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AuraCore-Medical-Technologies-Inc/olo-mobile"
  },
  "bugs": {
    "url": "https://github.com/AuraCore-Medical-Technologies-Inc/olo-mobile/issues"
  },
  "homepage": "https://github.com/devamitch/eye-scan-mobile-app#readme"
}
